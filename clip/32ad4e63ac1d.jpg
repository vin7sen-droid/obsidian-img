ass=pl-c1\u003eSTATE_REBOOT\u003c/span\u003e) { \u003cspan class=pl-c\u003e/* dispatch a queued reboot */\u003c/span\u003e","                                (\u003cspan class=pl-smi\u003evoid\u003c/span\u003e) \u003cspan class=pl-en\u003ereboot\u003c/span\u003e(\u003cspan class=pl-c1\u003eRB_AUTOBOOT\u003c/span\u003e);","                                \u003cspan class=pl-s1\u003er\u003c/span\u003e \u003cspan class=pl-c1\u003e=\u003c/span\u003e \u003cspan class=pl-en\u003elog_error_errno\u003c/span\u003e(\u003cspan class=pl-s1\u003eerrno\u003c/span\u003e, \u003cspan class=pl-s\u003e\u0026quot;Failed to reboot: %m\u0026quot;\u003c/span\u003e);","                                goto \u003cspan class=pl-ent\u003efinish\u003c/span\u003e;","","                        } \u003cspan class=pl-k\u003eelse\u003c/span\u003e \u003cspan class=pl-k\u003eif\u003c/span\u003e (\u003cspan class=pl-s1\u003estate\u003c/span\u003e \u003cspan class=pl-c1\u003e==\u003c/span\u003e \u003cspan class=pl-c1\u003eSTATE_POWEROFF\u003c/span\u003e)","                                (\u003cspan class=pl-smi\u003evoid\u003c/span\u003e) \u003cspan class=pl-en\u003ereboot\u003c/span\u003e(\u003cspan class=pl-c1\u003eRB_POWER_OFF\u003c/span\u003e); \u003cspan class=pl-c\u003e/* if this fails, fall back to normal exit. */\u003c/span\u003e","","                        \u003cspan class=pl-k\u003eif\u003c/span\u003e (\u003cspan class=pl-s1\u003esi\u003c/span\u003e.\u003cspan class=pl-c1\u003esi_pid\u003c/span\u003e \u003cspan class=pl-c1\u003e==\u003c/span\u003e \u003cspan class=pl-s1\u003epid\u003c/span\u003e \u003cspan class=pl-c1\u003e\u0026amp;\u0026amp;\u003c/span\u003e \u003cspan class=pl-s1\u003esi\u003c/span\u003e.\u003cspan class=pl-c1\u003esi_code\u003c/span\u003e \u003cspan class=pl-c1\u003e==\u003c/span\u003e \u003cspan class=pl-c1\u003eCLD_EXITED\u003c/span\u003e)","                                \u003cspan class=pl-s1\u003er\u003c/span\u003e \u003cspan class=pl-c1\u003e=\u003c/span\u003e \u00